# API key của xah.io — KHÔNG commit file .env.local
XAH_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Danh sách domain được phép gọi API, cách nhau bằng dấu phẩy
# Local dev:
#   http://localhost:5173,http://localhost:3000
# Production (sau khi biết domain Vercel):
#   https://astra-ai.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000